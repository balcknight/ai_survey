# 邮件开关（默认建议 false）
MAIL_ENABLED=false

# 收件人
MAIL_TO=zhurui8901@novogene.com

# 公司内部邮件网关（HTTP 接口，无需账号密码）
MAIL_API_URL=http://172.17.64.36:8075/api/
MAIL_LOCAL=TJ

# 邮件内容
MAIL_SUBJECT_PREFIX=[Survey提醒]
MAIL_CASE_LIST_URL=http://10.11.0.6:5173/cases

# ---- 登录鉴权 ----
# token 有效期（小时），默认 168（7 天）
AUTH_TOKEN_TTL_HOURS=168
# 首次启动 users 表为空时自动创建的默认管理员
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=管理员
# 留空则首次启动生成随机密码并打印到启动日志
ADMIN_PASSWORD=
