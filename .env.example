# 邮件开关（默认建议 false）
MAIL_ENABLED=false

# 发件人和收件人（当前为占位）
MAIL_FROM=1623893955@qq.com
MAIL_TO=zhurui8901@novogene.com

# SMTP 配置（QQ 邮箱）
MAIL_SMTP_HOST=smtp.qq.com
MAIL_SMTP_PORT=465
MAIL_SMTP_USE_SSL=true
MAIL_SMTP_USERNAME=1623893955@qq.com
MAIL_SMTP_PASSWORD=<QQ邮箱SMTP授权码>

# 邮件内容
MAIL_SUBJECT_PREFIX=[Survey提醒]
